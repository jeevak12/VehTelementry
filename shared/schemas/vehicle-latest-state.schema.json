{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VehicleLatestState",
  "type": "object",
  "required": ["vehicleId", "lastTimestamp", "latitude", "longitude", "speedKph", "batteryPercent", "status"],
  "properties": {
    "vehicleId": { "type": "string" },
    "lastTimestamp": { "type": "string", "format": "date-time" },
    "latitude": { "type": "number" },
    "longitude": { "type": "number" },
    "speedKph": { "type": "number" },
    "batteryPercent": { "type": "number" },
    "status": { "type": "string", "enum": ["MOVING", "STOPPED", "OFFLINE", "ALERTING"] },
    "activeAlerts": {
      "type": "array",
      "items": { "type": "string", "enum": ["OVERSPEED", "LOW_BATTERY", "TELEMETRY_LOSS"] }
    },
    "lastUpdatedAt": { "type": "string", "format": "date-time" }
  }
}
